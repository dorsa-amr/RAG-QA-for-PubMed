# OpenAI API Key
OPENAI_API_KEY=your_api_key_here

# Vector DB Settings
VECTOR_DB_PATH=./data/vector_db
CHROMA_DB_PATH=./data/chroma_db

# PubMed Settings
PUBMED_BATCH_SIZE=100
PUBMED_MAX_ARTICLES=500
PUBMED_USE_FULL_TEXT=true
PUBMED_FULL_TEXT_CHAR_LIMIT=20000
# Optional: NCBI asks for a contact email; a free API key raises the rate limit
NCBI_EMAIL=
NCBI_API_KEY=

# Retrieval Parameters
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM Model
MODEL_NAME=gpt-4o-mini
# Changing this requires reloading the articles
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0
MAX_TOKENS=2000
